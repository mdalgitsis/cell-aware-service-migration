# Service orchestrator northbound interface
ORCHESTRATOR_HOST=orchestrator.example.com
ORCHESTRATOR_USER=you@example.com
ORCHESTRATOR_PASSWORD=
ORCHESTRATOR_ORG=00000000-0000-0000-0000-000000000000

# Subscriber whose session events drive migration
SUPI_OF_INTEREST=001010000000000

# Edge application the orchestrator should move
SERVICE_NAME=kserve_model

# Optional tuning
LISTEN_PORT=8880
POLL_INTERVAL_SECONDS=0.5
MIGRATION_TIMEOUT_SECONDS=300
TOPOLOGY_PATH=/app/config/topology.yaml
